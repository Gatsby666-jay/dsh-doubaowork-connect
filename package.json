{
  "name": "dsh-doubaowork-connect",
  "displayName": "DSH Connect 豆包工作",
  "description": "把本机登录的豆包工作模型接入 DeepSeek Harness：每次刷新按上游目录自动读取每个模型的积分倍率，支持逐模型图片输入开关、多账号切换与账号池自动换号，并提供每日签到状态与卡片、输入框里的胶囊积分读数等只读积分概览。",
  "version": "0.2.0",
  "private": true,
  "author": "Gatsby666-jay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gatsby666-jay/dsh-doubaowork-connect.git"
  },
  "homepage": "https://github.com/Gatsby666-jay/dsh-doubaowork-connect#readme",
  "bugs": {
    "url": "https://github.com/Gatsby666-jay/dsh-doubaowork-connect/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "doubao",
    "doubao-work",
    "model-provider",
    "credits"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
